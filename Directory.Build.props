<Project>
  <PropertyGroup>
    <!-- The one place the package id prefix lives. -->
    <PackagePrefix>RecursiveAI</PackagePrefix>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Build output goes to $(ONEHTML_ARTIFACTS) when set, otherwise to an ignored folder in the repo.
       This keeps bin/ and obj/ out of the checkout and lets several worktrees build side by side. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ONEHTML_ARTIFACTS)' != ''">$([MSBuild]::EnsureTrailingSlash('$(ONEHTML_ARTIFACTS)'))</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONEHTML_ARTIFACTS)' == ''">$(MSBuildThisFileDirectory)artifacts/</ArtifactsPath>
  </PropertyGroup>
</Project>
