<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Deterministic source paths on CI, for the shipped libraries only: tests find their data files through their own source paths. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>$(PackagePrefix).$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(PackagePrefix).$(MSBuildProjectName)</RootNamespace>
    <PackageId>$(PackagePrefix).$(MSBuildProjectName)</PackageId>
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- The one place the package version lives. All three packages ship with the same version. -->
    <Version>1.5.0</Version>
    <PackageProjectUrl>https://github.com/recursive-ai-oss/onehtml-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onehtml-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Every public type and member carries an XML doc comment; a missing one fails the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each package folder holds its own README.md. -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
