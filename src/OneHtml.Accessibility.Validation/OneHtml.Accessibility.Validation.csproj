<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Accessibility checks that need no browser: one rule catalogue across WCAG 2.0, 2.1 and 2.2 and best practices, labelled results, suggested edits where one fix exists, and native, axe-compatible and SARIF 2.1.0 output.</Description>
    <PackageTags>accessibility a11y wcag act-rules axe sarif html validation</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OneHtml.Accessibility/OneHtml.Accessibility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference data generated by tools/catalogue; read by the loaders in Catalogue/. -->
    <EmbeddedResource Include="Catalogue/Data/*.json" LogicalName="Catalogue.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- ARIA in HTML role table, generated by tools/validation/generate-allowed-roles.py. -->
    <EmbeddedResource Include="Rules/Data/*.json" LogicalName="Rules.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
