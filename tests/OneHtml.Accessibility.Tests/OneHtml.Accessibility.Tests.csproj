<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RecursiveAI.OneHtml.Accessibility.Tests</RootNamespace>
    <!-- CA1707: test names use underscores. xUnit1051: the library calls under test are synchronous and finish in
         milliseconds, so there is nothing to cancel. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../tools/OneHtml.Differential/AxModel.cs" Link="Differential/AxModel.cs" />
    <Compile Include="../../tools/OneHtml.Differential/AxComparer.cs" Link="Differential/AxComparer.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneHtml.Accessibility/OneHtml.Accessibility.csproj" />
  </ItemGroup>
</Project>
