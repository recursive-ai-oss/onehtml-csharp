<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RecursiveAI.OneHtml.Accessibility.Validation.Tests</RootNamespace>
    <!-- CS0649: the shared FakeSnapshot helper has fields that only the tree tests assign. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../OneHtml.Accessibility.Tests/FakeSnapshot.cs" Link="FakeSnapshot.cs" />
    <Compile Include="../../tools/OneHtml.Differential/AxeModel.cs" Link="Differential/AxeModel.cs" />
    <Compile Include="../../tools/OneHtml.Differential/AxeCompare.cs" Link="Differential/AxeCompare.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- ReadmeSampleTests checks the README code blocks against ReadmeSamples.cs. -->
    <None Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/OneHtml/README.md" Link="README.OneHtml.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/OneHtml.Accessibility/README.md" Link="README.Accessibility.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/OneHtml.Accessibility.Validation/README.md" Link="README.Validation.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ReadmeSamples.cs" Link="ReadmeSamples.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneHtml.Accessibility.Validation/OneHtml.Accessibility.Validation.csproj" />
  </ItemGroup>
</Project>
