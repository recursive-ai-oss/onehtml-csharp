<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RecursiveAI.OneHtml.Tests</RootNamespace>
    <!-- CA1707: test names use underscores. xUnit1051: the library calls under test are synchronous and finish in
         microseconds, so there is nothing for the test run's cancellation token to cancel. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../testdata/css/**/*" LinkBase="testdata/css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../fuzz/OneHtml.Fuzz/CssTarget.cs" Link="Css/CssTarget.cs" />
    <Compile Include="../../fuzz/OneHtml.Fuzz/ValueTarget.cs" Link="Css/ValueTarget.cs" />
    <Compile Include="../../fuzz/OneHtml.Fuzz/SelectorTarget.cs" Link="Selectors/SelectorTarget.cs" />
    <Compile Include="../../fuzz/OneHtml.Fuzz/EditTarget.cs" Link="Editing/EditTarget.cs" />
    <Compile Include="../../fuzz/OneHtml.Fuzz/EditOracle.cs" Link="Editing/EditOracle.cs" />
    <Compile Include="../../fuzz/OneHtml.Fuzz/StyleTarget.cs" Link="Style/StyleTarget.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneHtml/OneHtml.csproj" />
  </ItemGroup>
</Project>
